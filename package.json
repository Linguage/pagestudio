{
  "name": "pagestudio-dsh",
  "version": "0.5.2",
  "type": "module",
  "description": "浏览、导入和整理本地 HTML 知识卡片。",
  "author": "Linguage",
  "repository": { "type": "git", "url": "git+https://github.com/Linguage/pagestudio.git" },
  "homepage": "https://github.com/Linguage/pagestudio",
  "keywords": ["dsh-plugin", "html", "slides"],
  "license": "UNLICENSED",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "web", "vendor", "skills", "icon.svg", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=22.19", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": [] } },
  "scripts": {
    "seed": "node scripts/seed.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:host": "node scripts/check-host.mjs",
    "package": "node scripts/package.mjs"
  }
}
